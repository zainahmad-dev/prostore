# Copy this file to `.env` and fill in values before running the app or seeding the DB

NEXT_PUBLIC_APP_NAME="Threadly"
NEXT_PUBLIC_APP_DESCRIPTION="A modern e-commerce website built with Next.js"
# Must be the public origin of the deployment - it backs metadataBase and the
# absolute URLs in emails.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Example Neon/Postgres connection string (replace with your own credentials)
DATABASE_URL="postgresql://<username>:<password>@<host>/<database>?sslmode=require"

# Auth.js v5 reads AUTH_SECRET / AUTH_URL (the NEXTAUTH_* names are v4 only).
# Generate a secret with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL=http://localhost:3000

# Comma-separated. The first entry is used when a user has not picked one yet.
PAYMENT_METHODS="PayPal,Stripe,CashOnDelivery"
DEFAULT_PAYMENT_METHOD="PayPal"

# Rows per page in the storefront and admin tables.
PAGE_SIZE=12
LATEST_PRODUCTS_LIMIT=4

# UploadThing (product image uploads)
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Email (Resend). Leave RESEND_API_KEY empty in dev to log emails to the server
# console instead of sending them. Get a key at https://resend.com.
RESEND_API_KEY=
# The "from" address. Must be a verified domain/sender in your Resend account.
# The default onboarding sender only delivers to your own account email.
EMAIL_SENDER="Threadly <onboarding@resend.dev>"
